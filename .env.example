# pips — environment template. NEVER commit a filled-in copy; real values live in
# VM-side env files on arb-vm, referenced by compose, and are never baked into an image.

# --- Data plane (read-only). Breeze credentials live ONLY in the reader process. ---
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

# --- Order plane. Broker credentials live ONLY in the order adapter process. ---
# The two planes never share a process, a credential, or a config file (rule 7).
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# --- Runtime ---
PIPS_DATA_ROOT=/srv/pips
PIPS_ENV=dev

# --- Live-flag chain (rule 8). All three are required, and none of them belongs here.
# PIPS_LIVE is set by a human on arb-vm only, never by the loop, never in this file.
# PIPS_LIVE=0
