# pips — runtime environment.
#
# TRACKED IN GIT by owner decision (ADR-0011). This repository is private, and the Breeze
# session token rotates daily, which bounds the exposure window of any single value here.
#
# READ THIS BEFORE PASTING A TOKEN:
#   * git history is permanent. A value committed here stays in every clone and every fork
#     forever, and rotating it later does not remove it from past commits.
#   * this file NEVER enters a container image — .dockerignore excludes it and a test pins
#     that. That half of rule 14 is unchanged.
#   * the ORDER plane's credentials do not belong here (rule 7: two planes, two credentials,
#     two processes). Broker secrets stay in the VM-side env file the order adapter reads.
#
# Daily update procedure: ops/runbooks/breeze-token.md

# --- Data plane (read-only). Breeze credentials ONLY. -------------------------------
BREEZE_API_KEY=U0b44C7H073096M02UK3S2971i811Y9H
BREEZE_API_SECRET=6s4915151357Su668dCe6tfo4b4I!90w
# Rotates daily. Regenerate from the Breeze portal and paste it here, then commit.
BREEZE_SESSION_TOKEN=56897841

# Owner-confirmed Breeze quota (ADR-0012). The per-minute rate is still UNCONFIRMED, so the
# fetcher keeps a conservative per-minute throttle until the M3 probe measures it.
BREEZE_MAX_CALLS_PER_DAY=100000
BREEZE_MAX_PARALLEL_FETCHES=32

# --- Runtime ------------------------------------------------------------------------
# ALL market data and runtime state live on the VM (rule 14). This is a VM path, and a
# laptop run mounts fixtures instead — it never points at a directory inside this repo.
PIPS_DATA_ROOT=/srv/pips
PIPS_ENV=dev

# --- Live-flag chain (rule 8) --------------------------------------------------------
# NOT set here and never set by the loop. PIPS_LIVE=1 is a human act on arb-vm, and it is
# only one of the conditions — see config/live.yaml.example.
# PIPS_LIVE=0
