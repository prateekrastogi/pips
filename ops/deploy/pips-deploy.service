# pips deploy rail — one poll of origin/main. Triggered by pips-deploy.timer.
[Unit]
Description=pips deploy rail — poll origin/main, build, gate, promote
Documentation=file:///srv/pips/checkout/ops/deploy/README.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/pips/checkout
# VM-side secrets. Order-plane credentials live here and NOWHERE in git (rule 7); the Breeze
# data-plane token is the one exception and rides in the repo's .env (ADR-0011).
EnvironmentFile=-/srv/pips/secrets/deploy.env
ExecStart=/srv/pips/checkout/ops/deploy/sync.sh
# A failed poll must not retry in a storm — the next timer tick is the retry (donor property
# 4: failures alert and stop). systemd would otherwise restart a oneshot on failure.
Restart=no
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
