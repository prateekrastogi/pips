#!/usr/bin/env bash
# pips pre-push gate — Jenkins CI must be green before anything leaves this machine.
#
# Install with `make install-hooks`.
#
# WHY A HOOK AND NOT A HABIT. `make ci` on a laptop and `pips-ci` in Jenkins are not the same
# check, and the difference has already bitten twice: build #1 caught `.python-version` being
# untracked, and build #9 caught `.gitignore` being excluded from the image. Both passed
# locally and failed from a clean checkout. A local green says "it works here"; the Jenkins
# green says "it works from what you actually pushed".
#
# Bypass with `git push --no-verify` — deliberately available, deliberately explicit, and it
# should appear in the session log when used (constitution rule 10: never route around a gate
# quietly).

set -uo pipefail

REMOTE="${1:-origin}"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# Deleting a branch, or pushing nothing, needs no build.
if [ -z "$(git rev-list "@{u}..HEAD" 2>/dev/null || git rev-list HEAD -1)" ]; then
  echo "pre-push: nothing to build"
  exit 0
fi

# PIN WHAT THE GATE IS GATING. The Jenkins build takes ~15 minutes, and a commit made on this
# branch during that window has, by definition, never been seen by the gate. On 2026-09-05 a
# push started with main at e13dc08, Jenkins built e13dc08, a further commit dd3a55b was made at
# 10:00Z mid-gate, and GitHub recorded the push landing dd3a55b -- deployed without any build
# having seen it. Controlled experiments show `git push` sending the PRE-hook ref, so the exact
# mechanism is not explained; this guard does not depend on explaining it. If HEAD is not where
# it was when the gate began, the push is refused, whatever else may be true.
GATED_SHA="$(git rev-parse HEAD)"

echo "pre-push: running the Jenkins gate for '$BRANCH' (${GATED_SHA:0:12}) before pushing to $REMOTE"
TRIGGER="$(git rev-parse --show-toplevel)/ops/jenkins/trigger.sh"
if [ ! -x "$TRIGGER" ] && [ ! -f "$TRIGGER" ]; then
  echo "pre-push: $TRIGGER not found — cannot run the gate. Refusing (fail closed)." >&2
  exit 1
fi

# The trigger exits 3 when it could not reach the controller, as distinct from a red build.
# Both block the push -- failing closed is right -- but they need different responses: a red
# build means fix the code, an unreachable controller means retry or check the controller.
# Reporting one as the other sent this project to debug tests that passed.
GATE_DID_NOT_RUN=3

# CALLED DIRECTLY, NOT THROUGH `make jenkins-build`. Make exits 2 for ANY failed recipe, so
# routing the trigger through it flattens 3 (could not reach) and 1 (red) into the same number
# — which is the exact distinction this hook exists to make. `make jenkins-build` remains the
# entry point for humans, who read the message rather than the exit code.
bash "$TRIGGER" "$BRANCH"
STATUS=$?

if [ "$STATUS" -eq 0 ]; then
  NOW_SHA="$(git rev-parse HEAD)"
  if [ "$NOW_SHA" != "$GATED_SHA" ]; then
    cat >&2 <<MSG
pre-push: REFUSED — '$BRANCH' moved while the gate was running.

  gated:  ${GATED_SHA:0:12}   (this is what Jenkins built and passed)
  now:    ${NOW_SHA:0:12}   (this is what would be pushed)

The commits between them have never been built. A green gate on the old tip says nothing about
the new one. Nothing was pushed. Run \`git push\` again: the gate will run on the current tip.
MSG
    exit 1
  fi
  echo "pre-push: pips-ci GREEN for '$BRANCH' at ${GATED_SHA:0:12} — pushing"
  exit 0
fi

if [ "$STATUS" -eq "$GATE_DID_NOT_RUN" ]; then
  cat >&2 <<'MSG'
pre-push: THE GATE DID NOT RUN — push blocked. The specific reason is printed above.

This is NOT a red build. Nothing was tested, so nothing is known. Two causes look alike from
here, and the line above is what tells them apart:

  * the controller is down — `make jenkins-up`, `make jenkins-logs`, then push again;
  * the build is still QUEUED behind one already in flight — pips-ci builds one at a time,
    so wait for that build to finish rather than retrying into the same queue.

Blocked rather than waved through, because an untested push and a tested one must not look
alike. If you must push anyway, use `git push --no-verify` and record why in
docs/state/log/<today>.md.
MSG
  exit 1
fi

cat >&2 <<'MSG'
pre-push: pips-ci is RED — push blocked.

The build ran and failed. Fix it; do not weaken the check (constitution rule 10). If you must
push anyway (e.g. to hand the branch to someone), use:

    git push --no-verify

and record why in docs/state/log/<today>.md — a bypassed gate that leaves no trace is
indistinguishable from a gate that never ran.
MSG
exit 1
